{
  "type": "module",
  "name": "comic-pile",
  "version": "0.1.0",
  "description": "Dice-Driven Comic Reading Tracker - Rust + React + TypeScript",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.94.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "htmlhint": "^1.1.5",
    "jiti": "^2.6.1",
    "oxlint": "1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "testdriverai": "^7.11.58-test",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "build": "pnpm --filter frontend run build",
    "audit:ui": "bash scripts/run_ui_audit.sh",
    "lint": "pnpm --filter frontend run lint",
    "lint:fix": "pnpm --filter frontend exec eslint . --fix",
    "lint:anti-slop": "oxlint -c .oxlintrc.json",
    "dice:playground": "pnpm --filter frontend run dice:playground",
    "test:dice-playground": "pnpm --filter frontend run test:dice-playground",
    "test:dice-playground:update": "pnpm --filter frontend run test:dice-playground:update",
    "test:e2e:prod-smoke": "pnpm --filter frontend run test:e2e:prod-smoke"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
