# =============================================================================
# Comic Pile - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# Required variables are marked with (REQUIRED).
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# (REQUIRED) PostgreSQL database connection URL
# Local Docker PostgreSQL is exposed on port 5435 and application access is async.
DATABASE_URL=postgresql+asyncpg://comicpile:comicpile_password@localhost:5435/comicpile

# Database URL for running tests (optional, uses separate test database)
# Uses asyncpg driver for better performance
# Default: postgresql+asyncpg://comicpile:comicpile_password@localhost:5435/comicpile_test
TEST_DATABASE_URL=postgresql+asyncpg://comicpile:comicpile_password@localhost:5435/comicpile_test

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------

# (REQUIRED) Secret key for JWT token signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# JWT token expiration settings (optional, defaults shown)
# Access tokens default to 12 hours (720 minutes) so ordinary browsing and
# tab-focus revalidation do not refresh every half hour. The httpOnly refresh
# cookie is the durable session and matches REFRESH_TOKEN_EXPIRE_DAYS.
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Environment mode: development, production, or test
# Default: development
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
# (REQUIRED in production mode, optional in development)
# Example: https://example.com,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Enable debug routes (should be false in production)
# Default: false
ENABLE_DEBUG_ROUTES=false

# Enable internal operations routes (admin endpoints)
# Default: false
ENABLE_INTERNAL_OPS_ROUTES=false

# Logging level: debug, info, warning, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Session & Game Settings
# -----------------------------------------------------------------------------

# Hours of inactivity before starting a new reading session (1-168)
# Default: 6
SESSION_GAP_HOURS=6

# Starting die size for new sessions (4-20)
# Default: 6
START_DIE=6

# -----------------------------------------------------------------------------
# Rating System Settings
# -----------------------------------------------------------------------------

# Minimum allowed rating value (0.0-5.0)
# Default: 0.5
RATING_MIN=0.5

# Maximum allowed rating value (0.5-5.0)
# Default: 5.0
RATING_MAX=5.0

# Rating threshold for "good" rating that moves thread to front (0.5-5.0)
# Default: 4.0
RATING_THRESHOLD=4.0

# -----------------------------------------------------------------------------
# CI/Testing (used in CI environments)
# -----------------------------------------------------------------------------

# Set to "true" when running in CI environment
# CI=true

# Skip worktree check (for testing)
# SKIP_WORKTREE_CHECK=false

# -----------------------------------------------------------------------------
# Production variables (uncomment for production deployment)
# -----------------------------------------------------------------------------
# POSTGRES_USER=comicpile_prod
# POSTGRES_PASSWORD=<strong-random-password>
# POSTGRES_DB=comicpile_prod
# Generate SECRET_KEY with: openssl rand -base64 32

# Neon project ID and API key used by production migrations (deploy-production.yml)
# and make prod-migrate to fetch the main branch's direct (unpooled) connection URL
# via the Neon API. Both are created automatically by the Neon GitHub integration.
# NEON_PROJECT_ID=<project-id>
# NEON_API_KEY=<api-key>
#
# Optional override for make prod-migrate: a direct (unpooled) Neon connection URL.
# Use the direct Neon endpoint host, NOT the -pooler pooled host.
# NEON_DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/comicpile?sslmode=require

# -----------------------------------------------------------------------------
# Password-reset outbound email (Resend, issue #2778)
# -----------------------------------------------------------------------------
# Resend is the selected outbound email provider for password-reset delivery.
# All three values are required in production; when any is missing the app
# uses a deterministic fake mailer (local development and tests only) and
# password-reset emails are recorded in-memory instead of sent, with a
# password_reset_email_unconfigured warning in the logs.
#
# RESEND_API_KEY is already configured in the Vercel production environment.
# Never copy the secret value into GitHub, logs, source, or issue comments.
# RESEND_API_KEY=re_...
#
# Sender identity must use a domain verified in the Resend dashboard.
# Verification requires owner-controlled DNS records (SPF/DKIM TXT records
# shown by Resend for the sending domain). If the domain is not yet verified,
# Resend rejects the message and the app logs a delivery failure while still
# returning the enumeration-safe acknowledgement.
# PASSWORD_RESET_SENDER=Comic Pile <no-reply@example.com>
#
# Public web origin used to build the user-facing reset link (no trailing
# slash). This must be the origin users open in a browser.
# PASSWORD_RESET_ORIGIN=https://your-comic-pile.example
#
# Optional: public reset-page path (default: /reset-password).
# PASSWORD_RESET_PATH=/reset-password

# -----------------------------------------------------------------------------
# Bug Reporting (GitHub Integration)
# -----------------------------------------------------------------------------

# Personal access token with `repo` scope (Issues: write is sufficient for fine-grained tokens)
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO_OWNER=JoshCLWren
# GITHUB_REPO_NAME=comic-pile

# -----------------------------------------------------------------------------
# Cache Provider (production decision #1785)
# -----------------------------------------------------------------------------
