{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "question": "deny",
    "bash": {
      "*": "deny",
      "cat *": "allow",
      "find *": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "grep *": "allow",
      "head *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "gh api --method POST repos/*/pulls/*/comments*": "allow"
    }
  }
}
