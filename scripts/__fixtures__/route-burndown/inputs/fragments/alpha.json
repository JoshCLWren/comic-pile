{
  "family": "alpha",
  "owned_path_patterns": ["^/api/v2/alpha$"],
  "defaults": {"owning_issue": 42, "status": "complete", "runtime": "native-rust"},
  "operations": [
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/alpha",
      "dest": "/api/native_api.rs",
      "consumers": ["alpha.ts"]
    }
  ]
}
