{
  "routes": [
    {
      "src": "^/api/v1/legacy$",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_api.rs"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/native_api.rs"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "builds": [
    {
      "src": "api/native_api.rs",
      "use": "@vercel/rust"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "static/react"
      }
    }
  ]
}
