{
  "routes": [
    {
      "src": "^/api/v1/legacy$",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_api.rs"
    },
    {
      "src": "^/api/v2/unicode$",
      "methods": [
        "GET",
        "OPTIONS"
      ],
      "dest": "/api/index.py"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/native_api.rs"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
