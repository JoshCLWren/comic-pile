{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dice:playground": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "vite build",
    "generate:api-types": "cd .. && python scripts/generate_openapi_types.py",
    "check:api-types": "cd .. && python scripts/generate_openapi_types.py --check",
    "lint": "eslint .",
    "lint:anti-slop": "cd .. && oxlint --config .oxlintrc.json --ignore-pattern '.github/**'",
    "typecheck": "tsc -P tsconfig.json --noEmit && tsc -P tsconfig.test.json --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest run && pnpm run test:style-audit && pnpm run test:sitemap && pnpm run test:seo-launch",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage && pnpm run test:style-audit && pnpm run test:sitemap && pnpm run test:seo-launch && pnpm run audit:style",
    "test:ui": "vitest --ui",
    "test:style-audit": "node --test scripts/style-audit.test.mjs",
    "test:sitemap": "node --test scripts/generate-sitemap.test.mjs",
    "test:seo-launch": "node --test scripts/seo-launch-audit.test.mjs",
    "audit:style": "node scripts/style-audit.mjs",
    "audit:seo-launch": "node scripts/seo-launch-audit.mjs",
    "audit:ui": "pnpm run build && playwright test --config=playwright.audit.config.ts --workers=1",
    "capture:readme-roll": "node scripts/capture-readme-roll-hero.mjs",
    "test:e2e": "pnpm run build && sh -c 'if [ -n \"$PLAYWRIGHT_WORKERS\" ]; then playwright test --workers=\"$PLAYWRIGHT_WORKERS\"; else playwright test; fi'",
    "test:e2e:smoke": "node scripts/e2e-mode.mjs smoke",
    "test:e2e:affected": "node scripts/e2e-mode.mjs affected",
    "test:e2e:full": "node scripts/e2e-mode.mjs full",
    "test:e2e:ui": "pnpm run build && playwright test --ui --workers=1",
    "test:e2e:debug": "pnpm run build && playwright test --debug --workers=1",
    "test:e2e:headed": "pnpm run build && playwright test --headed --workers=1",
    "test:e2e:quick": "playwright test",
    "test:e2e:parallel": "pnpm run build && playwright test",
    "test:e2e:prod-smoke": "playwright test --config=playwright.prod.config.ts",
    "test:e2e:prod-profile": "playwright test --config=playwright.prod-profile.config.ts",
    "test:e2e:prod-all": "playwright test --config=playwright.prod-all.config.ts",
    "test:e2e:prod-all:headed": "playwright test --config=playwright.prod-all.config.ts --headed",
    "test:e2e:p0": "pnpm run build && playwright test --config=playwright.p0.config.ts",
    "test:e2e:regression": "node scripts/e2e-regression.mjs",
    "test:dice-playground": "playwright test --config=playwright.dice.config.ts",
    "test:dice-playground:update": "playwright test --config=playwright.dice.config.ts --update-snapshots"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/jsdom": "^30.0.0",
    "axios": "^1.20.0",
    "jiti": "^2.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "^1.89.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-sri": "^0.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
