# Frontend environment variables for Vite builds.
# Copy to `.env` in this directory when you need to override defaults locally.

# Enable the collection UI and related filtering controls.
# Default: false
VITE_ENABLE_COLLECTIONS=false

# Surface the "Find my reading mode" quiz launcher and suggestion prompts on the
# production Roll surface. Kept disabled by default (issue #1945): the quiz
# persists its result but the production Roll path does not yet consume the
# quiz-selected mode, so the launcher is misleading until the restoration gate
# is satisfied. The launcher component, API, persistence, and tests remain.
# Default: false
VITE_FEATURE_READING_MODE_QUIZ=false
