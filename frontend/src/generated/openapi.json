                  "$ref": "#/components/schemas/CreatorDiscoveryResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Creator Discoveries Endpoint",
        "tags": [
          "creators",
          "creators"
        ]
      }
    },
