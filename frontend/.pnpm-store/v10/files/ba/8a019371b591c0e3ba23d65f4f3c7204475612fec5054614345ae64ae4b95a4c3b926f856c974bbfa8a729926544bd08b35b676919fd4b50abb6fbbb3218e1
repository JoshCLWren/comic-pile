stedProtocols && requestedProtocols.length > 0) {\n    headers.set('sec-websocket-protocol', requestedProtocols[0])\n  }\n\n  return new FetchResponse(null, {\n    status: 101,\n    headers,\n  })\n}\n\n/**\n * Creates a request handler that responds to WebSocket upgrade\n * requests whose URL matches the given path.\n *\n * @internal\n */\nexport function createWebSocketUpgradeHandler(\n  url: Path,\n  resolver: (\n    info: WebSocketUpgradeRequestInfo,\n  ) => Promise<Response | undefined> | Response | undefined,\n) {\n  return http.get(({ request }) => {\n    return (\n      request.headers.get('upgrade')?.toLowerCase() === 'websocket' &&\n      matchRequestUrl(new URL(resolveWebSocketUrl(request.url)), url).matches\n    )\n  }, resolver)\n}\n"],"mappings":";;;;AAQA,MAAM,iBAAiB;;;;;;;;AAevB,eAAsB,iBAAiB,EACrC,WAC6D;CAC7D,MAAM,MAAM,QAAQ,QAAQ,IAAI,mBAAmB;CAEnD,IAAI,CAAC,KACH;CAGF,MAAM,WAAW,IAAI,YAAY,CAAC,CAAC,OAAO,MAAM,cAAc;CAC9D,MAAM,SAAS,MAAM,OAAO,OAAO,OAAO,SAAS,QAAQ;CAC3D,MAAM,cAAc,KAAK,OAAO,aAAa,GAAG,IAAI,WAAW,MAAM,CAAC,CAAC;CAIvE,MAAM,qBAAqB,QAAQ,QAChC,IAAI,wBAAwB,CAAC,EAC5B,MAAM,GAAG,CAAC,CACX,KAAK,aAAa,SAAS,KAAK,CAAC;CAEpC,IAAI,UAAU,oBAAoB,QAAQ,GAAG,GAAG,kBAAkB;CAElE,MAAM,UAAU,IAAI,QAAQ;EAC1B,SAAS;EACT,YAAY;EACZ,wBAAwB;CAC1B,CAAC;CAKD,IAAI,sBAAsB,mBAAmB,SAAS,GACpD,QAAQ,IAAI,0BAA0B,mBAAmB,EAAE;CAG7D,OAAO,IAAI,cAAc,MAAM;EAC7B,QAAQ;EACR;CACF,CAAC;AACH;;;;;;;AAQA,SAAgB,8BACd,KACA,UAGA;CACA,OAAO,KAAK,KAAK,EAAE,cAAc;EAC/B,OACE,QAAQ,QAAQ,IAAI,SAAS,CAAC,EAAE,YAAY,MAAM,eAClD,gBAAgB,IAAI,IAAI,oBAAoB,QAAQ,GAAG,CAAC,GAAG,GAAG,CAAC,CAAC;CAEpE,GAAG,QAAQ;AACb"}