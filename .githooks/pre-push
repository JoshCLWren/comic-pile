#!/usr/bin/env bash
# Pre-push hook - runs before push to remote

set -euo pipefail

echo "Running pre-push CI parity checks..."

# Ensure we're running at repo root
if [ ! -f "pyproject.toml" ]; then
    echo "ERROR: Run from repository root."
    exit 1
fi

HEAD_SHA="$(git rev-parse HEAD)"
VERIFY_STAMP=".git/comic-pile-prepush-verified"
if [ -f "$VERIFY_STAMP" ]; then
    stamped="$(tr -d '[:space:]' < "$VERIFY_STAMP" || true)"
    stamp_age="$(( $(date +%s) - $(stat -c %Y "$VERIFY_STAMP") ))"
    if [ "$stamped" = "$HEAD_SHA" ] && [ "$stamp_age" -lt 3600 ]; then
        echo "Pre-push already verified for ${HEAD_SHA:0:12} (${stamp_age}s ago); proceeding to push."
        exit 0
    fi
fi

# Activate venv if not already active (worktree-aware)
if [ -z "${VIRTUAL_ENV:-}" ]; then
    VENV_PATH=".venv/bin/activate"
    if [ ! -f "$VENV_PATH" ] && [ -f .git ]; then
        GIT_COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null || true)
        if [ -n "$GIT_COMMON_DIR" ]; then
            MAIN_REPO_DIR=$(dirname "$GIT_COMMON_DIR")
            if [ -f "$MAIN_REPO_DIR/.venv/bin/activate" ]; then
                VENV_PATH="$MAIN_REPO_DIR/.venv/bin/activate"
                echo "Activating venv from main repo: $MAIN_REPO_DIR"
            fi
        fi
    fi

    if [ -f "$VENV_PATH" ]; then
        # shellcheck disable=SC1090
        source "$VENV_PATH"
    else
        echo "ERROR: No virtual environment found. Run 'uv venv && uv sync --all-extras' first."
        exit 1
    fi
fi

if ! command -v pnpm >/dev/null 2>&1; then
    echo "ERROR: pnpm is required for frontend lint/tests."
    exit 1
fi

if [ ! -d "frontend/node_modules" ]; then
    echo "Installing frontend dependencies (frontend/node_modules missing)..."
    pnpm install --frozen-lockfile
fi

echo ""
echo "1/4 Running lint (scripts/lint.sh)..."
bash scripts/lint.sh

echo ""
echo "2/4 Running backend tests with coverage..."
python -m pytest tests/ --cov=comic_pile --cov-report=xml

echo ""
echo "3/4 Running frontend unit tests..."
(
    cd frontend
    pnpm test
)

echo ""
echo "4/4 Running rendered UI audit (CI parity)..."
pnpm run audit:ui

echo ""
echo "All pre-push checks passed."
echo "Note: full Playwright product E2E is not part of default CI; run make verify-e2e when needed."
printf '%s\n' "$HEAD_SHA" > "$VERIFY_STAMP"
