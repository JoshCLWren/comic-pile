#!/bin/bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Running pre-commit checks..."

# Check for type ignores and linter ignores
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$PYTHON_FILES" ]; then
    echo ""
    echo "Checking for type ignores and linter ignores in staged files..."

    IGNORES_FOUND=0

    for file in $PYTHON_FILES; do
        if git show ":$file" | grep -qE '# type:? ?ignore|# noqa|# ruff:? ?ignore|# pylint:? ?ignore' 2>/dev/null; then
            echo "${YELLOW}Found type/linter ignore in $file${NC}"
            git show ":$file" | grep -nE '# type:? ?ignore|# noqa|# ruff:? ?ignore|# pylint:? ?ignore' | sed 's/^/  /'
            IGNORES_FOUND=1
        fi
    done

    if [ $IGNORES_FOUND -eq 1 ]; then
        echo ""
        echo "${RED}ERROR: Type or linter ignores found in staged files.${NC}"
        echo "${RED}Please review CONTRIBUTING.md and remove these ignores before committing.${NC}"
        exit 1
    fi
fi

# Block forbidden paths — node_modules, pipeline artifacts, etc.
FORBIDDEN_STAGED=$(git diff --cached --name-only | grep -E "^node_modules|^frontend/node_modules|^review_critique\.md" || true)
if [ -n "$FORBIDDEN_STAGED" ]; then
    echo ""
    echo "${RED}ERROR: Forbidden files staged for commit:${NC}"
    echo "$FORBIDDEN_STAGED" | sed 's/^/  /'
    echo "${RED}Remove them with: git rm --cached <file>${NC}"
    exit 1
fi

# Block backup artifacts (*.bak, *.backup, *.orig, *~) — editor/LLM leftovers
# never belong in version control. Deletions are allowed so existing backups
# can be untracked.
BACKUP_PATTERN='\.(bak|backup|orig)$|~$'
BACKUP_STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -Ei "$BACKUP_PATTERN" || true)
if [ -n "$BACKUP_STAGED" ]; then
    echo ""
    echo "${RED}ERROR: Backup files staged for commit:${NC}"
    echo "$BACKUP_STAGED" | sed 's/^/  /'
    echo "${RED}Backup artifacts (*.bak, *.backup, *.orig, *~) are banned from this repository.${NC}"
    echo "${RED}Delete them locally instead of committing them.${NC}"
    exit 1
fi

RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$RUST_FILES" ]; then
    if ! command -v rustfmt >/dev/null 2>&1; then
        echo "${RED}ERROR: rustfmt is required to commit Rust files (rustup component add rustfmt).${NC}"
        exit 1
    fi
    echo ""
    echo "Formatting staged Rust files with rustfmt..."
    for file in $RUST_FILES; do
        # Re-staging a file that also has unstaged edits would commit those edits.
        if ! git diff --quiet -- "$file"; then
            if ! rustfmt --edition 2021 --check "$file" >/dev/null; then
                echo "${RED}ERROR: $file is not formatted and has unstaged changes.${NC}"
                echo "${RED}Run cargo fmt --all, review the result, and stage it.${NC}"
                exit 1
            fi
            continue
        fi
        rustfmt --edition 2021 "$file"
        git add -- "$file"
    done
fi

# Shared staged lint. The Python push gate remains the separate whole-repo
# `ruff check .` and `ty check --error-on-warning` pair; lint.sh does not run them.
bash scripts/lint.sh --staged

