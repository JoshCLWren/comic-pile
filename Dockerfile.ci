# Keep frontend tooling identical to the production image.
FROM node:22.23.1-trixie-slim AS node-runtime

# Stage 1: Python 3.14 with the shared CI system dependencies.
FROM python:3.14-slim AS base
ENV DEBIAN_FRONTEND=noninteractive

# Copy only Node-specific files so the Python installation remains intact.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

# Install non-browser system dependencies. Playwright browsers and their OS
# deps are installed on-demand in the CI workflow (ui-audit job) and in the
# local CI runner (scripts/run_ci_local.sh), not bundled into this shared
# image consumed by non-browser jobs such as lint, typecheck, unit tests, and
# migration checks.
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gpg \
        gh \
        jq \
        postgresql-client \
        tar \
        tzdata \
        ripgrep \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Stage 2: Minimal Python tooling for CI helpers and linters.
# The Python application runtime was retired; keep only a plain interpreter
# venv with the CI lint/typecheck tools that existing jobs invoke.
FROM base AS python-env
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/workspace/.venv/bin:$PATH"

RUN python -m venv .venv && \
    .venv/bin/python -c "import sys; assert sys.version_info[:2] == (3, 14), sys.version" && \
    .venv/bin/pip install --no-cache-dir --upgrade pip && \
    .venv/bin/pip install --no-cache-dir ruff==0.17.6 ty==0.0.107

# Stage 3: Frontend dependencies (no Playwright browsers — installed on-demand).
FROM python-env AS frontend-deps
RUN npm install -g pnpm@10.15.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/
RUN pnpm install --frozen-lockfile

# Stage 4: Frontend build.
FROM frontend-deps AS frontend-build
COPY frontend/ frontend/
# Local API forwarding derives from production ingress, which must be present
# when Vite evaluates its configuration inside this isolated Docker stage.
COPY vercel.json ./vercel.json
RUN pnpm --filter frontend run build

# Stage 5: Final image with everything.
FROM frontend-build AS final
RUN .venv/bin/python -c "import sys; assert sys.version_info[:2] == (3, 14), sys.version" && \
    mkdir -p /opt/ci-assets/static
COPY --from=frontend-build /workspace/static/react /opt/ci-assets/static/react
COPY --from=frontend-build /workspace/static/react /workspace/static/react
ENV PATH="/workspace/.venv/bin:$PATH"
CMD ["/bin/bash"]
