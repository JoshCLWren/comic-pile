{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cle1"
  ],
  "crons": [
    {
      "path": "/api/v1/cron/release-sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/v1/cron/comicvine-metadata-repair",
      "schedule": "0 10 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{target/**,native/**/target/**}"
      }
    },
    {
      "src": "api/native_roll.rs",
      "use": "@vercel/rust"
    },
    {
      "src": "api/native_issue.rs",
      "use": "@vercel/rust"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "static/react"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/auth/me",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v1/auth/login",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v1/auth/register",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v1/auth/refresh",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v1/auth/logout",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v1/auth/csrf",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v1/auth/forgot-password",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v1/auth/reset-password",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/auth/register",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/auth/login",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/auth/refresh",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/auth/logout",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/auth/csrf",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/auth/me",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/auth/forgot-password",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/auth/reset-password",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/auth/me",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/auth/login",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/auth/register",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/auth/refresh",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/auth/logout",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/auth/csrf",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/auth/forgot-password",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/auth/reset-password",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/_native_roll/health",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/roll/bootstrap",
      "methods": [
        "GET"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/roll/dice-command",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/roll/offer",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/roll/reset",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/reading-boundaries",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/queue-entries/:thread_id",
      "methods": ["GET"],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/queue-entries/:thread_id",
      "methods": ["PATCH"],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v2/queue-orders",
      "methods": ["POST"],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/v1/roll/dismiss-pending",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/roll/dismiss-pending",
      "methods": [
        "POST"
      ],
      "dest": "/api/native_roll.rs"
    },
    {
      "src": "/api/_native_issue/health",
      "methods": ["GET"],
      "dest": "/api/native_issue.rs"
    },
    {
      "src": "^/api/v2/issues/[0-9]+$",
      "methods": ["PATCH"],
      "dest": "/api/native_issue.rs"
    },
    {
      "src": "^/api/v2/issues/cards$",
      "methods": ["POST"],
      "dest": "/api/native_issue.rs"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/(?:openapi\\.json|docs|redoc|health)",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; frame-src 'none';",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-ComicPile-Frontend": "vercel-static",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block"
      }
    },
    {
      "src": "/assets/.+",
      "continue": true,
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(analytics|cbl-sources|continuity-plans|continuity-plans/events|continuity-plans/new|creators|creators/compare|crossovers|demo|forgot-password|glossary|help|history|identity-inbox|login|queue|rate|register|reset-password|roll|whats-new)(\\.html)?",
      "dest": "/$1.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; frame-src 'none';",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-ComicPile-Frontend": "vercel-static",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-Robots-Tag": "noindex, nofollow",
        "X-XSS-Protection": "1; mode=block"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; frame-src 'none';",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-ComicPile-Frontend": "vercel-static",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-Robots-Tag": "noindex, nofollow",
        "X-XSS-Protection": "1; mode=block"
      }
    }
  ]
}
