# Native Rust process used only by the isolated Playwright UI audit stack.
# All bootstrap GET requests are handled by the same Rust/Axum service as production.
FROM rust:1.99.1-bookworm AS builder
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
# The root Cargo workspace and single root Cargo.lock build both the service and
# the deployed Vercel ingress from one locked dependency graph.
COPY Cargo.toml Cargo.lock build.rs ./
COPY api/native_roll.rs api/native_issue.rs ./api/
COPY native/roll-service/Cargo.toml ./native/roll-service/
COPY native/roll-service/src/ ./native/roll-service/src/
# Test fixtures are loaded on demand by Rust tests; no SQL dump belongs in a
# deployable service image or is required to compile the runtime binary.
RUN cargo build --locked -p comicpile-roll-service --bin comicpile-roll-service

FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /workspace/target/debug/comicpile-roll-service /usr/local/bin/comicpile-roll-service
ENTRYPOINT ["/usr/local/bin/comicpile-roll-service"]
