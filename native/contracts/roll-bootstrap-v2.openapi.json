{
  "components": {
    "schemas": {
      "ActiveThreadInfo": {
        "description": "Schema for active thread information in session response.",
        "properties": {
          "format": {
            "title": "Format",
            "type": "string"
          },
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "issue_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "DEPRECATED: Always equals next_issue_id. Use next_issue_id instead.",
            "title": "Issue Id"
          },
          "issue_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "DEPRECATED: Always equals next_issue_number. Use next_issue_number instead.",
            "title": "Issue Number"
          },
          "issues_read": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issues Read"
          },
          "issues_remaining": {
            "title": "Issues Remaining",
            "type": "integer"
          },
          "last_rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Rating"
          },
          "last_rolled_result": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Rolled Result"
          },
          "next_issue_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The next unread issue ID to read",
            "title": "Next Issue Id"
          },
          "next_issue_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The next unread issue number (e.g., '5', 'Annual 1')",
            "title": "Next Issue Number"
          },
          "queue_position": {
            "title": "Queue Position",
            "type": "integer"
          },
          "reading_progress": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reading Progress"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagResponse"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "total_issues": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Issues"
          }
        },
        "required": [
          "id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "last_rolled_result"
        ],
        "title": "ActiveThreadInfo",
        "type": "object"
      },
      "BlockingDependency": {
