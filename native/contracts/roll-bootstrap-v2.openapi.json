      "SessionBandwidthState": {
        "description": "Canonical ephemeral bandwidth state for the active reading session.\n\nEvery field is always present but nullable so legacy sessions that predate\nbandwidth tracking serialize to a stable, safe shape instead of a missing\nor partially shaped object. This is the single canonical source consumed by\nlater weighting and UI work.",
        "properties": {
          "active_bandwidth": {
            "anyOf": [
              {
                "enum": [
                  "light",
                  "balanced",
                  "deep"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Bandwidth"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "mode_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
