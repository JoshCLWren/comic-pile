            "type": "integer"
          },
          "inactive_threads": {
            "items": {
              "$ref": "#/components/schemas/ThreadExclusionReason"
            },
            "title": "Inactive Threads",
            "type": "array"
          },
          "last_read": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RollLastRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_rolled_result": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Rolled Result"
          },
          "manual_die": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manual Die"
          },
          "pending_thread_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending Thread Id"
          },
          "roll_recovery": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RollRecoveryInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "rollable": {
            "items": {
              "$ref": "#/components/schemas/RollableItem"
            },
            "title": "Rollable",
            "type": "array"
          },
          "session_id": {
            "title": "Session Id",
            "type": "integer"
          },
          "session_mode": {
            "$ref": "#/components/schemas/SessionMode"
          },
          "skipped_thread_ids": {
            "default": [],
            "items": {
              "type": "integer"
            },
            "title": "Skipped Thread Ids",
            "type": "array"
          },
          "skipped_threads": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/RollableThread"
            },
            "title": "Skipped Threads",
            "type": "array"
          },
          "snoozed_count": {
            "title": "Snoozed Count",
            "type": "integer"
          },
          "snoozed_threads": {
