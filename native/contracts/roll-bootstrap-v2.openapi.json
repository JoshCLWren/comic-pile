  "openapi": "3.1.0",
  "paths": {
    "/api/v2/roll/bootstrap": {
      "get": {
        "description": "Return v2 bootstrap data for the Roll initial render.\n\nThis is a breaking sibling of the existing bootstrap with no unversioned alias.\nIt provides a superset response replacing roll_pool with rollable[] and adding\nnullable session-scoped last_read while preserving all v1 semantics.\n\nArgs:\n    current_user: The authenticated user.\n    db: Async database session.\n    timezone: Optional browser-resolved IANA timezone identifier captured once\n        per active reading session. Invalid or unusable values leave the field\n        unset and never break the roll.\n\nReturns:\n    RollV2BootstrapResponse with v2 contract including rollable and last_read.",
        "operationId": "roll_v2_bootstrap_api_v2_roll_bootstrap_get",
        "parameters": [
          {
            "description": "Browser IANA timezone identifier",
            "in": "query",
            "name": "timezone",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Browser IANA timezone identifier",
              "title": "Timezone"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RollV2BootstrapResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Roll V2 Bootstrap",
        "tags": [
          "roll",
          "roll"
        ]
      }
    }
  }
