{
  "openapi": "3.1.0",
  "info": {
    "title": "comicpile-roll-service",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/sessions/{session_id}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Documentation-only operation for the unversioned mounted read.",
        "operationId": "get_session_documentation",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "Owned reading session",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Session not found"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/sessions/{session_id}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Documentation-only operation for the versioned mounted read.",
        "operationId": "get_session_v1_documentation",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "Owned reading session",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Session not found"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SessionActiveThread": {
        "type": "object",
        "description": "Active (pending or freshly rolled) thread projection for one session.",
        "required": [
          "id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "tags"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "issues_read": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "last_rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "last_rolled_result": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "next_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "next_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "queue_position": {
            "type": "integer",
            "format": "int32"
          },
          "reading_progress": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionTag"
            }
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "SessionBandwidthState": {
        "type": "object",
        "description": "Canonical bandwidth state; invalid stored values normalize to `null`.",
        "properties": {
          "active_bandwidth": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "mode_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "predicted_bandwidth": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SessionDetailResponse": {
        "type": "object",
        "description": "Wire shape of Python `SessionResponse` for `get_session`.",
        "required": [
          "id",
          "started_at",
          "start_die",
          "user_id",
          "ladder_path",
          "current_die",
          "has_restore_point",
          "snapshot_count",
          "snoozed_thread_ids",
          "snoozed_threads",
          "skipped_thread_ids",
          "skipped_threads",
          "reading_mode_suggested"
        ],
        "properties": {
          "active_thread": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SessionActiveThread"
              }
            ]
          },
          "bandwidth": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SessionBandwidthState"
              }
            ]
          },
          "correction": {},
          "current_die": {
            "type": "integer",
            "format": "int32"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_restore_point": {
            "type": "boolean"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "intent": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SessionIntentState"
              }
            ]
          },
          "ladder_path": {
            "type": "string"
          },
          "last_rolled_result": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "manual_die": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "pending_thread_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "reading_bandwidth": {
            "type": [
              "string",
              "null"
            ]
          },
          "reading_intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "reading_mode_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "reading_mode_suggested": {
            "type": "boolean"
          },
          "skipped_thread_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "skipped_threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionThreadSummary"
            }
          },
          "snapshot_count": {
            "type": "integer",
            "format": "int32"
          },
          "snoozed_thread_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "snoozed_threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionThreadSummary"
            }
          },
          "start_die": {
            "type": "integer",
            "format": "int32"
          },
          "started_at": {
            "type": "string"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SessionIntentState": {
        "type": "object",
        "description": "Canonical intent state; invalid stored values normalize to `null`.",
        "properties": {
          "active_intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "mode_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "predicted_intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SessionTag": {
        "type": "object",
        "description": "One direct visible tag on the active thread.",
        "required": [
          "id",
          "name",
          "normalized_name",
          "scope",
          "color",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "color": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "normalized_name": {
            "type": "string"
          },
          "owner_user_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "scope": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "SessionThreadSummary": {
        "type": "object",
        "description": "Compact thread summary used for the (empty on this endpoint) snoozed and\nskipped lists, kept typed so the contract stays explicit.",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
