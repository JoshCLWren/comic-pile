{
  "openapi": "3.1.0",
  "info": {
    "title": "ComicPile native same-path thread ordering API",
    "description": "Generated contract for the native thread ordering and dependency-inspection handlers that retain their original method and path.",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/threads/{thread_id}/dependency-order-check": {
      "get": {
        "tags": [
          "dependencies"
        ],
        "summary": "Documentation-only operation for the dependency order check.",
        "operationId": "thread_ordering_dependency_order_check",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dependency edges that disagree with issue positions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadDependencyOrderCheckResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}/issues:validateOrder": {
      "get": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for issue order validation.",
        "operationId": "thread_ordering_validate_order",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Human-readable ordering warnings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueOrderValidationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}/reading-orders": {
      "get": {
        "tags": [
          "reading-orders"
        ],
        "summary": "Documentation-only operation for reading orders containing a thread.",
        "operationId": "thread_ordering_reading_orders",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned reading orders containing the thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadReadingOrdersResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
