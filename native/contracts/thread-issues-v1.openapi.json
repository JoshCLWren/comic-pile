{
  "openapi": "3.1.0",
  "info": {
    "title": "ComicPile native same-path thread issue API",
    "description": "Generated contract for the native thread issue-management handlers that retain their original method and path.",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/threads/{thread_id}/issues": {
      "post": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for issue creation.",
        "operationId": "thread_issues_create",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueCreateRange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Newly created issues",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadIssueCreateListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or fully duplicate range"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread or anchor issue not found"
          },
          "409": {
            "description": "Issue number already exists"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}/issues/creators": {
      "get": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for the bulk creator read.",
        "operationId": "thread_issues_creators",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored creator credits per mapped issue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadIssueCreatorsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}/issues:reorder": {
      "post": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for issue reordering.",
        "operationId": "thread_issues_reorder",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueReorderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Order rewritten"
          },
          "400": {
            "description": "issue_ids must name every issue exactly once"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}:migrateToIssues": {
      "post": {
        "tags": [
          "threads"
        ],
        "summary": "Documentation-only operation for the explicit migration.",
        "operationId": "thread_issues_migrate",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MigrateToIssuesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Migrated thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Already migrated or inconsistent range"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}:migrateToIssuesSimple": {
      "post": {
        "tags": [
          "threads"
        ],
        "summary": "Documentation-only operation for the simplified migration.",
        "operationId": "thread_issues_migrate_simple",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MigrateToIssuesSimpleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Migrated thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Already migrated or issue cannot be created"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}:setCurrentIssue": {
      "post": {
        "tags": [
          "threads"
        ],
        "summary": "Documentation-only operation for correcting the current issue.",
        "operationId": "thread_issues_set_current",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCurrentIssueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Corrected current issue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetCurrentIssueResponse"
                }
              }
            }
          },
          "400": {
            "description": "Thread inactive, untracked or issue unavailable"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread or issue not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreatorCredit": {
        "type": "object",
        "description": "One credited creator (Python `ComicVineCreator`).",
        "required": [
          "name",
          "roles"
        ],
        "properties": {
          "creator_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "IssueCreateRange": {
        "type": "object",
        "description": "Request body of `POST /api/v1/threads/{thread_id}/issues`.",
        "required": [
          "issue_range"
        ],
        "properties": {
          "insert_after_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Insert after this issue id; omit for natural placement, null to append."
          },
          "issue_range": {
            "type": "string",
            "description": "Range such as `1-25` or `1, 3, 5-7`."
          }
        }
      },
      "IssueCreatorsEntry": {
        "type": "object",
        "description": "Stored creator credits for one issue (Python `IssueCreatorsEntry`).",
        "required": [
          "issue_id",
          "creators"
        ],
        "properties": {
          "creators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatorCredit"
            }
          },
          "issue_id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "IssueReorderRequest": {
        "type": "object",
        "description": "Request body of `POST /api/v1/threads/{thread_id}/issues:reorder`.",
        "required": [
          "issue_ids"
        ],
        "properties": {
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "IssueResponse": {
        "type": "object",
        "description": "One issue row (Python `IssueResponse`).",
        "required": [
          "id",
          "thread_id",
          "issue_number",
          "position",
          "status",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "issue_number": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "read_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "thread_id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MigrateToIssuesRequest": {
        "type": "object",
        "description": "Request body of `POST /api/v1/threads/{thread_id}:migrateToIssues`.",
        "required": [
          "last_issue_read",
          "total_issues"
        ],
        "properties": {
          "last_issue_read": {
            "type": "integer",
            "format": "int32"
          },
          "total_issues": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MigrateToIssuesSimpleRequest": {
        "type": "object",
        "description": "Request body of `POST /api/v1/threads/{thread_id}:migrateToIssuesSimple`.",
        "required": [
          "issue_number"
        ],
        "properties": {
          "issue_number": {
            "type": "string"
          }
        }
      },
      "SetCurrentIssueRequest": {
        "type": "object",
        "description": "Request body of `POST /api/v1/threads/{thread_id}:setCurrentIssue`.",
        "required": [
          "issue_number"
        ],
        "properties": {
          "issue_number": {
            "type": "string"
          }
        }
      },
      "SetCurrentIssueResponse": {
        "type": "object",
        "description": "Python `SetCurrentIssueResponse`.",
        "required": [
          "thread_id",
          "title",
          "format",
          "issues_remaining",
          "queue_position"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "next_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "next_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "queue_position": {
            "type": "integer",
            "format": "int32"
          },
          "reading_progress": {
            "type": [
              "string",
              "null"
            ]
          },
          "thread_id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ThreadIssueCreateListResponse": {
        "type": "object",
        "description": "Newly created issues (Python `IssueListResponse`). Named distinctly from the v2 `IssueListResponse` so merged contracts never collide.",
        "required": [
          "issues",
          "total_count",
          "page_size"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueResponse"
            }
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_size": {
            "type": "integer",
            "format": "int32"
          },
          "total_count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ThreadIssueCreatorsResponse": {
        "type": "object",
        "description": "Bulk creator credits for one thread (Python `ThreadIssueCreatorsResponse`).",
        "required": [
          "thread_id",
          "issues"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueCreatorsEntry"
            }
          },
          "thread_id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ThreadResponse": {
        "type": "object",
        "description": "Python `ThreadResponse`.",
        "required": [
          "id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "status",
          "is_test",
          "is_blocked",
          "blocking_reasons",
          "created_at",
          "manual_creator_credits"
        ],
        "properties": {
          "blocking_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "is_blocked": {
            "type": "boolean"
          },
          "is_test": {
            "type": "boolean"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "last_activity_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "manual_creator_credits": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next_unread_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "next_unread_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "queue_position": {
            "type": "integer",
            "format": "int32"
          },
          "reading_progress": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
