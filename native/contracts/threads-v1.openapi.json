{
  "openapi": "3.1.0",
  "info": {
    "title": "ComicPile native same-path Thread lifecycle v1 API",
    "description": "Generated contract for the native Thread lifecycle handlers that retain their original method and path.",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/threads/": {
      "post": {
        "tags": [
          "threads"
        ],
        "description": "Create a thread at the end of the reader's queue.",
        "operationId": "create_thread_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThreadCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created (or the duplicate created seconds earlier)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/check-duplicates": {
      "post": {
        "tags": [
          "threads"
        ],
        "description": "Advisory check for existing volumes that may be the proposed series.",
        "operationId": "check_potential_duplicates_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckDuplicatesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Possible existing volumes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckDuplicatesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/excluded/threads": {
      "get": {
        "tags": [
          "threads"
        ],
        "description": "List the reader's excluded threads with cursor pagination.",
        "operationId": "list_excluded_threads_documentation",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive title filter",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "position, title or created (default created)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Page size (1-200, default 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Opaque continuation cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Excluded thread page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported sort or stale page token"
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/groups:batch": {
      "post": {
        "tags": [
          "threads"
        ],
        "description": "List crossover groups for several owned threads in one request.",
        "operationId": "list_thread_groups_batch_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupsBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Map of thread id to crossover groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DependencyGroupSummary"
                    }
                  },
                  "propertyNames": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "A requested thread is not owned by the reader"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/reactivate": {
      "post": {
        "tags": [
          "threads"
        ],
        "description": "Reactivate a completed thread by adding more issues.",
        "operationId": "reactivate_thread_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReactivateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Reactivated thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Thread is not completed"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/stale": {
      "get": {
        "tags": [
          "threads"
        ],
        "description": "List active threads not read in `days` days.",
        "operationId": "list_stale_threads_documentation",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "description": "Staleness threshold in days (default 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Maximum results (1-200, default 200)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stale threads, oldest activity first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ThreadResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}": {
      "put": {
        "tags": [
          "threads"
        ],
        "description": "Update an owned thread.",
        "operationId": "update_thread_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThreadUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "threads"
        ],
        "description": "Delete a thread and prune dependent session and continuity state.",
        "operationId": "delete_thread_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "description": "The database refused the deletion"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}/exclude": {
      "post": {
        "tags": [
          "threads"
        ],
        "description": "Remove an active thread from the queue without deleting data.",
        "operationId": "exclude_thread_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Excluded thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Thread is not active"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}/restore": {
      "post": {
        "tags": [
          "threads"
        ],
        "description": "Restore an excluded thread to the queue (or the finished shelf).",
        "operationId": "restore_thread_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Restored thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Thread is not excluded"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/threads/{thread_id}/set-pending": {
      "post": {
        "tags": [
          "threads"
        ],
        "description": "Manually select a thread as the pending roll.",
        "operationId": "set_pending_thread_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Optional exact-issue guard",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SetPendingRequest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selected thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RollResponse"
                }
              }
            }
          },
          "400": {
            "description": "Thread is inactive, blocked or out of issues"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "409": {
            "description": "The offered issue is no longer next"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CheckDuplicatesRequest": {
        "type": "object",
        "description": "Body of `POST /api/v1/threads/check-duplicates`.",
        "required": [
          "title",
          "format"
        ],
        "properties": {
          "comicvine_volume_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "exclude_thread_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "format": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CheckDuplicatesResponse": {
        "type": "object",
        "description": "Response of `POST /api/v1/threads/check-duplicates`.",
        "required": [
          "matches"
        ],
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PotentialDuplicateMatch"
            }
          }
        }
      },
      "ComicVineMappingHealth": {
        "type": "object",
        "description": "Compact confirmed ComicVine mapping health for one queue row.",
        "required": [
          "status",
          "tracked_issue_count",
          "confirmed_issue_count",
          "needs_mapping_count",
          "needs_review_count",
          "metadata_missing_count"
        ],
        "properties": {
          "confirmed_issue_count": {
            "type": "integer",
            "format": "int32"
          },
          "metadata_missing_count": {
            "type": "integer",
            "format": "int32"
          },
          "needs_mapping_count": {
            "type": "integer",
            "format": "int32"
          },
          "needs_review_count": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          },
          "tracked_issue_count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DependencyGroupSummary": {
        "type": "object",
        "description": "Compact crossover group metadata.",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "GroupsBatchRequest": {
        "type": "object",
        "description": "Body of `POST /api/v1/threads/groups:batch`.",
        "required": [
          "thread_ids"
        ],
        "properties": {
          "thread_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "PotentialDuplicateMatch": {
        "type": "object",
        "description": "One possible existing volume.",
        "required": [
          "thread_id",
          "title",
          "format",
          "status",
          "issues_remaining",
          "match_type"
        ],
        "properties": {
          "comicvine_volume_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "format": {
            "type": "string"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "match_type": {
            "type": "string"
          },
          "start_year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "status": {
            "type": "string"
          },
          "thread_id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "QueueExclusionGroupRef": {
        "type": "object",
        "description": "Bulk exclusion provenance attached to an excluded queue thread (#5435).",
        "required": [
          "id",
          "source_kind",
          "source_id",
          "source_name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "source_id": {
            "type": "integer",
            "format": "int32"
          },
          "source_kind": {
            "type": "string"
          },
          "source_name": {
            "type": "string"
          }
        }
      },
      "QueueSeriesMetadata": {
        "type": "object",
        "description": "Confirmed provider series metadata for one queue row.",
        "properties": {
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "volume": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ReactivateRequest": {
        "type": "object",
        "description": "Body of `POST /api/v1/threads/reactivate`.",
        "required": [
          "thread_id",
          "issues_to_add"
        ],
        "properties": {
          "issues_to_add": {
            "type": "integer",
            "format": "int32"
          },
          "thread_id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RollResponse": {
        "type": "object",
        "description": "Response body: the Python `RollResponse` projection for a manual pick.",
        "required": [
          "thread_id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "die_size",
          "result",
          "offset",
          "snoozed_count"
        ],
        "properties": {
          "die_size": {
            "type": "integer",
            "format": "int32"
          },
          "explanation": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "type": "string"
          },
          "issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "next_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "next_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "queue_position": {
            "type": "integer",
            "format": "int32"
          },
          "reading_progress": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": "integer",
            "format": "int32"
          },
          "snoozed_count": {
            "type": "integer",
            "format": "int32"
          },
          "thread_id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "SetPendingRequest": {
        "type": "object",
        "description": "Optional body of `POST /api/v1/threads/{thread_id}/set-pending`.",
        "properties": {
          "expected_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ThreadCreateRequest": {
        "type": "object",
        "description": "Body of `POST /api/v1/threads/`.",
        "required": [
          "title",
          "format",
          "issues_remaining"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "is_test": {
            "type": "boolean"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "manual_creator_credits": {
            "type": "array",
            "items": {}
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ThreadListItem": {
        "type": "object",
        "description": "One reader threads collection item.",
        "required": [
          "id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "status",
          "is_blocked",
          "blocking_reasons",
          "created_at",
          "manual_creator_credits",
          "tags"
        ],
        "properties": {
          "blocking_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comicvine_mapping": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ComicVineMappingHealth"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "is_blocked": {
            "type": "boolean"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "last_activity_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "manual_creator_credits": {},
          "next_unread_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "queue_exclusion_group": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QueueExclusionGroupRef",
                "description": "Present when this excluded thread was removed as part of a bulk action."
              },
              {
                "type": "null"
              }
            ]
          },
          "queue_position": {
            "type": "integer",
            "format": "int32"
          },
          "series_cover_image_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Derived series cover: the exact provider CDN URL of the thread's next\nunread confirmed issue, falling back to the first confirmed issue with a\ncover. Null when the series has no confirmed issue cover."
          },
          "series_metadata": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QueueSeriesMetadata"
              },
