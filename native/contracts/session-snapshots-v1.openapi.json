{
  "openapi": "3.1.0",
  "info": {
    "title": "ComicPile native session snapshot API",
    "version": "1.0.0",
    "description": "Same-path Rust contract for the browser-called session snapshot list slice."
  },
  "paths": {
    "/api/sessions/{session_id}/snapshots": {
      "$ref": "#/paths/~1api~1v1~1sessions~1{session_id}~1snapshots"
    },
    "/api/v1/sessions/{session_id}/snapshots": {
      "get": {
        "tags": ["sessions"],
        "security": [{"HTTPBearer": []}],
        "parameters": [{
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {"type": "integer", "format": "int32"}
        }],
        "responses": {
          "200": {
            "description": "Session restore snapshots",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionSnapshotsResponse"}}}
          },
          "401": {"description": "Not authenticated"},
          "404": {"description": "Session not found"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"HTTPBearer": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "SessionSnapshotItem": {
        "type": "object",
        "required": ["id", "session_id", "created_at", "description"],
        "properties": {
          "id": {"type": "integer", "format": "int32"},
          "session_id": {"type": "integer", "format": "int32"},
          "created_at": {"type": "string", "format": "date-time"},
          "description": {"type": ["string", "null"]},
          "event_id": {"type": ["integer", "null"], "format": "int32"}
        }
      },
      "SessionSnapshotsResponse": {
        "type": "object",
        "required": ["session_id", "snapshots"],
        "properties": {
          "session_id": {"type": "integer", "format": "int32"},
          "snapshots": {"type": "array", "items": {"$ref": "#/components/schemas/SessionSnapshotItem"}}
        }
      }
    }
  }
}
