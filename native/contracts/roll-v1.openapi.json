{
  "openapi": "3.1.0",
  "info": {
    "title": "ComicPile native same-path Roll v1 API",
    "description": "Generated contract for the native Roll handlers that retain their original method and path.",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/roll/events/{event_id}/recommendation-explanation": {
      "get": {
        "tags": [
          "roll"
        ],
        "summary": "Also mount the legacy-handler alias.",
        "operationId": "recommendation_explanation_legacy_documentation",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "description": "Roll event identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ordered explanation factors for the roll event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationExplanationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Event does not exist or belongs to another reader"
          },
          "422": {
            "description": "Event is not a roll event"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/roll/override": {
      "post": {
        "tags": [
          "roll"
        ],
        "summary": "Also mount the legacy-handler alias.",
        "operationId": "override_roll_legacy_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RollOverrideRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Manually selected thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RollResponse"
                }
              }
            }
          },
          "400": {
            "description": "Thread is skipped or on snooze backoff"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread was not found for this reader"
          },
          "422": {
            "description": "Thread is blocked or not active"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/roll/events/{event_id}/recommendation-explanation": {
      "get": {
        "tags": [
          "roll"
        ],
        "summary": "Documentation-only operation for the mounted v1 same-path read.",
        "operationId": "recommendation_explanation_documentation",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "description": "Roll event identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ordered explanation factors for the roll event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationExplanationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Event does not exist or belongs to another reader"
          },
          "422": {
            "description": "Event is not a roll event"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/roll/override": {
      "post": {
        "tags": [
          "roll"
        ],
        "summary": "Documentation-only operation for the mounted v1 manual pick.",
        "operationId": "override_roll_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RollOverrideRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Manually selected thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RollResponse"
                }
              }
            }
          },
          "400": {
            "description": "Thread is skipped or on snooze backoff"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread was not found for this reader"
          },
          "422": {
            "description": "Thread is blocked or not active"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/roll/switch-prerequisite": {
      "post": {
        "tags": [
          "roll"
        ],
        "summary": "Documentation-only operation for the mounted v1 prerequisite switch.",
        "operationId": "switch_prerequisite_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RollPrerequisiteSwitchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Durable active target after accepting the prerequisite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RollPrerequisiteSwitchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Selected issue was not found for this reader"
          },
          "409": {
            "description": "No pending roll, or the guidance is stale"
          },
          "422": {
            "description": "Unsupported continuity-node type"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ExplainableFactor": {
        "type": "object",
        "description": "One human-readable explanation element returned by the API.",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code identifying the factor family."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional extended context or sub-note."
          },
          "label": {
            "type": "string",
            "description": "Short user-facing description."
          }
        }
      },
      "RecommendationExplanationResponse": {
        "type": "object",
        "description": "Aggregate recommendation explanation for a single roll event.",
        "required": [
          "event_id",
          "factors"
        ],
        "properties": {
          "event_id": {
            "type": "integer",
            "format": "int32",
            "description": "The roll event whose recommendation context was explained."
          },
          "factors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExplainableFactor"
            },
            "description": "Ordered list of human-readable explanation elements."
          }
        }
      },
      "RollOverrideRequest": {
        "type": "object",
        "description": "Request body for the manual override.",
        "required": [
          "thread_id"
        ],
        "properties": {
          "thread_id": {
            "type": "integer",
            "format": "int32",
            "description": "Reader-selected thread identifier."
          }
        }
      },
      "RollPrerequisiteSwitchRequest": {
        "type": "object",
        "description": "Request body for accepting one current recovery recommendation.",
        "required": [
          "node_type",
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "integer",
            "format": "int32",
            "description": "Recommended continuity-node identifier."
          },
          "node_type": {
            "type": "string",
            "description": "Recommended continuity-node type. Only concrete issues are accepted."
          }
        },
        "additionalProperties": false
      },
      "RollPrerequisiteSwitchResponse": {
        "type": "object",
        "description": "Durable active-target state after accepting a recovery recommendation.",
        "required": [
          "original_thread_id",
          "target_thread_id",
          "target_thread_title",
          "target_issue_id",
          "target_issue_number",
          "changed"
        ],
        "properties": {
          "changed": {
            "type": "boolean"
          },
          "original_thread_id": {
            "type": "integer",
            "format": "int32"
          },
          "target_issue_id": {
            "type": "integer",
            "format": "int32"
          },
          "target_issue_number": {
            "type": "string"
          },
          "target_thread_id": {
            "type": "integer",
            "format": "int32"
          },
          "target_thread_title": {
            "type": "string"
          }
        }
      },
      "RollResponse": {
        "type": "object",
        "description": "Response body: the Python `RollResponse` projection for a manual pick.",
        "required": [
          "thread_id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "die_size",
          "result",
          "offset",
          "snoozed_count"
        ],
        "properties": {
          "die_size": {
            "type": "integer",
            "format": "int32"
          },
          "explanation": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "type": "string"
          },
          "issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "next_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "next_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "queue_position": {
            "type": "integer",
            "format": "int32"
          },
          "reading_progress": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": "integer",
            "format": "int32"
          },
          "snoozed_count": {
            "type": "integer",
            "format": "int32"
          },
          "thread_id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
