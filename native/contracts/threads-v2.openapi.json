{
  "openapi": "3.1.0",
  "info": {
    "title": "comicpile-roll-service",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/threads/completed/threads": {
      "get": {
        "tags": [
          "threads"
        ],
        "operationId": "list_completed_threads_documentation",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive title search",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "position, title, or created",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "1-200 rows per page (default 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Opaque continuation cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped completed threads page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sort or page token"
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Invalid bounds"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/threads": {
      "get": {
        "tags": [
          "threads"
        ],
        "summary": "Documentation-only operation used to emit the generated OpenAPI contract.",
        "operationId": "list_threads_documentation",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "description": "Resource filter: active (default), completed, stale, excluded",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "Canonical ordering: position, title, created; last_activity for stale",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Legacy alias of order_by; supplying both with different values is rejected",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive title search; unsupported for filter=stale",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "description": "Stale age threshold in days (0-3650, default 30); only with filter=stale",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "1-200 rows per page (default 50, 200 for stale)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Opaque continuation cursor bound to filter, search and order_by",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped threads page; stale rows keep the detail-shaped projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadListResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter, order_by, sort or page token"
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Invalid bounds, unsupported parameter or retired collection_id"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "threads"
        ],
        "summary": "Documentation-only operation for the AIP-133 standard Create on the v2\nthreads collection (#5702). The handler lives in `thread_lifecycle` and\nshares the legacy write path; only the URL and the `Location` response\nheader differ.",
        "description": "Create a thread at the end of the authenticated reader's queue. The created resource (including its stable `id`) is returned at 201 with a `Location` header naming the v2 collection member. The write preserves owner assignment, the five-second duplicate-merge guard and the Python validation envelope; it creates no Plan, dependency or issue rows.",
        "operationId": "create_thread_v2_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThreadCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created (or the duplicate created seconds earlier)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/threads/{thread_id}": {
      "get": {
        "tags": [
          "threads"
        ],
        "summary": "Standard resource Get for one owned Thread.",
        "operationId": "get_thread_v2_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped thread detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found or not owned by the reader"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "threads"
        ],
        "description": "Delete an owned Thread (AIP-135). A second delete, or a delete of a foreign or already deleted Thread, returns 404. Never 403.",
        "operationId": "delete_thread_v2_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "description": "The database refused the deletion"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "threads"
        ],
        "description": "Partially update an owned Thread (AIP-134). Omitted fields are preserved. When `update_mask` is supplied only its fields are applied; a masked field missing from the body is cleared. An `expected` precondition that no longer matches the committed row returns 409 with `detail.code = thread_edit_conflict` and the current values. Foreign or deleted Threads return 404, never 403.",
        "operationId": "patch_thread_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThreadPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found (including another reader's thread)"
          },
          "409": {
            "description": "Stale `expected` precondition; reload before retrying"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ComicVineMappingHealth": {
        "type": "object",
        "description": "Compact confirmed ComicVine mapping health for one queue row.",
        "required": [
          "status",
          "tracked_issue_count",
          "confirmed_issue_count",
          "needs_mapping_count",
          "needs_review_count",
          "metadata_missing_count"
        ],
        "properties": {
          "confirmed_issue_count": {
            "type": "integer",
            "format": "int32"
          },
          "metadata_missing_count": {
            "type": "integer",
