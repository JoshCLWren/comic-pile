      "ThreadListItem": {
        "type": "object",
        "description": "One reader threads collection item.",
        "required": [
          "id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "status",
          "is_blocked",
          "blocking_reasons",
          "created_at",
