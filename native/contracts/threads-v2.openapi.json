{
  "openapi": "3.1.0",
  "info": {
    "title": "comicpile-roll-service",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/threads/completed/threads": {
      "get": {
        "tags": [
          "threads"
        ],
        "operationId": "list_completed_threads_documentation",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive title search",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "position, title, or created",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "1-200 rows per page (default 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Opaque continuation cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped completed threads page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sort or page token"
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Invalid bounds"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/threads": {
      "get": {
        "tags": [
          "threads"
        ],
        "summary": "Documentation-only operation used to emit the generated OpenAPI contract.",
        "operationId": "list_threads_documentation",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "description": "Resource filter: active (default), completed, stale, excluded",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "Canonical ordering: position, title, created; last_activity for stale",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Legacy alias of order_by; supplying both with different values is rejected",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive title search; unsupported for filter=stale",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "description": "Stale age threshold in days (0-3650, default 30); only with filter=stale",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "1-200 rows per page (default 50, 200 for stale)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "Opaque continuation cursor bound to filter, search and order_by",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped threads page; stale rows keep the detail-shaped projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadListResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter, order_by, sort or page token"
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Invalid bounds, unsupported parameter or retired collection_id"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "threads"
        ],
        "summary": "Documentation-only operation for the AIP-133 standard Create on the v2\nthreads collection (#5702). The handler lives in `thread_lifecycle` and\nshares the legacy write path; only the URL and the `Location` response\nheader differ.",
        "description": "Create a thread at the end of the authenticated reader's queue. The created resource (including its stable `id`) is returned at 201 with a `Location` header naming the v2 collection member. The write preserves owner assignment, the five-second duplicate-merge guard and the Python validation envelope; it creates no Plan, dependency or issue rows.",
        "operationId": "create_thread_v2_documentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThreadCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created (or the duplicate created seconds earlier)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/threads/{thread_id}": {
      "get": {
        "tags": [
          "threads"
        ],
        "summary": "Standard resource Get for one owned Thread.",
        "operationId": "get_thread_v2_documentation",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Owned Thread identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped thread detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Thread not found or not owned by the reader"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },      "ThreadPatchPrecondition": {
        "type": "object",
        "description": "Committed values a stale client read before issuing a Thread patch.",
        "properties": {
          "format": {
            "type": [
              "string",
              "null"
            ],
            "description": "Format observed by the client."
          },
          "manual_creator_credits": {
            "type": [
              "array",
              "null"
            ],
            "items": {},
            "description": "Manual creator credits observed by the client."
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Notes observed by the client; `null` means it observed no notes."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Title observed by the client."
          }
        }
      },
      "ThreadPatchRequest": {
        "type": "object",
        "description": "Body of `PATCH /api/v2/threads/{thread_id}`.\n\n`update_mask` follows AIP-134: when supplied, only the named fields are\napplied; a named field missing from the body is explicitly cleared. When it\nis omitted or empty, every field present in the body is applied and every\nomitted field is preserved (the legacy partial-update behavior).",
        "properties": {
          "expected": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ThreadPatchPrecondition",
                "description": "Optional stale-client precondition. Every supplied value must still\nmatch the committed row; otherwise the patch returns HTTP 409."
              },
              {
                "type": "null"
              }
            ]
          },
          "format": {
            "type": [
              "string",
              "null"
            ],
            "description": "New format; normalized to the reader's canonical vocabulary."
          },
          "is_test": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Test-series flag. Omit to preserve it."
          },
          "issues_remaining": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Manual issue counter for untracked series (legacy queue transition)."
          },
          "manual_creator_credits": {
            "type": [
              "array",
              "null"
            ],
            "items": {},
            "description": "Manual creator credits. `null` clears them; names and roles are bounded."
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Notes. `null` or a blank string clears the stored value; omit to keep it."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "New series title. Omitted fields are preserved."
          },
          "update_mask": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Explicit field mask (AIP-134). Either an array of field names or one\ncomma-separated string. Omit for presence-based partial update."
          }
        }
      },
      "ThreadResponse": {
        "type": "object",
        "description": "The Python `ThreadResponse` projection every lifecycle writer returns.",
        "required": [
          "id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "status",
          "is_test",
          "is_blocked",
          "blocking_reasons",
          "created_at",
          "manual_creator_credits"
        ],
        "properties": {
          "blocking_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "is_blocked": {
            "type": "boolean"
          },
          "is_test": {
            "type": "boolean"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "last_activity_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "manual_creator_credits": {},
          "next_unread_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "next_unread_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "queue_position": {
            "type": "integer",
            "format": "int32"
          },
          "reading_progress": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ThreadTag": {
        "type": "object",
        "description": "One tag visible to the reader.",
        "required": [
          "id",
          "name",
          "normalized_name",
          "scope",
          "color",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "color": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "normalized_name": {
            "type": "string"
          },
          "owner_user_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "scope": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
