            "type": "integer",
            "format": "int32"
          },
          "is_blocked": {
            "type": "boolean"
          },
          "is_test": {
            "type": "boolean"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "last_activity_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_rating": {
            "type": [
              "number",
