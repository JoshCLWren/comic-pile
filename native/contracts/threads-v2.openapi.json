                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "is_blocked": {
            "type": "boolean"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "last_activity_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "manual_creator_credits": {},
          "next_unread_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "queue_exclusion_group": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QueueExclusionGroupRef",
                "description": "Present when this excluded thread was removed as part of a bulk action."
              },
              {
                "type": "null"
              }
            ]
          },
          "queue_position": {
            "type": "integer",
            "format": "int32"
          },
          "series_cover_image_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Derived series cover: the exact provider CDN URL of the thread's next\nunread confirmed issue, falling back to the first confirmed issue with a\ncover. Null when the series has no confirmed issue cover."
          },
          "series_metadata": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QueueSeriesMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThreadTag"
            }
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ThreadListResponse": {
        "type": "object",
        "description": "Paginated reader threads collection.",
        "required": [
          "threads",
          "active_count"
        ],
        "properties": {
          "active_count": {
            "type": "integer",
            "format": "int32"
          },
          "filtered_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Total active Queue rows matching the applied search, independent of the bounded page."
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThreadListItem"
            }
          }
        }
      },
      "ThreadListResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ThreadListResponse"
          },
          {
            "$ref": "#/components/schemas/StaleThreadListResponse"
          }
        ],
        "description": "One v2 threads list response. The active/completed/excluded filters keep the\nqueue-list projection; the stale filter keeps the legacy detail-shaped\nprojection. Both are emitted inline (no envelope variant key)."
      },
      "ThreadPatchPrecondition": {
        "type": "object",
        "description": "Committed values a stale client read before issuing a Thread patch.",
        "properties": {
          "format": {
            "type": [
              "string",
              "null"
            ],
            "description": "Format observed by the client."
          },
          "manual_creator_credits": {
            "type": [
              "array",
              "null"
            ],
            "items": {},
            "description": "Manual creator credits observed by the client."
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Notes observed by the client; `null` means it observed no notes."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Title observed by the client."
          }
        }
      },
      "ThreadPatchRequest": {
        "type": "object",
        "description": "Body of `PATCH /api/v2/threads/{thread_id}`.\n\n`update_mask` follows AIP-134: when supplied, only the named fields are\napplied; a named field missing from the body is explicitly cleared. When it\nis omitted or empty, every field present in the body is applied and every\nomitted field is preserved (the legacy partial-update behavior).",
        "properties": {
          "expected": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ThreadPatchPrecondition",
                "description": "Optional stale-client precondition. Every supplied value must still\nmatch the committed row; otherwise the patch returns HTTP 409."
              },
              {
                "type": "null"
              }
            ]
          },
          "format": {
            "type": [
              "string",
              "null"
            ],
            "description": "New format; normalized to the reader's canonical vocabulary."
          },
          "is_test": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Test-series flag. Omit to preserve it."
          },
          "issues_remaining": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Manual issue counter for untracked series (legacy queue transition)."
          },
          "manual_creator_credits": {
            "type": [
              "array",
              "null"
            ],
            "items": {},
            "description": "Manual creator credits. `null` clears them; names and roles are bounded."
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Notes. `null` or a blank string clears the stored value; omit to keep it."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "New series title. Omitted fields are preserved."
          },
          "update_mask": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Explicit field mask (AIP-134). Either an array of field names or one\ncomma-separated string. Omit for presence-based partial update."
          }
        }
      },
      "ThreadResponse": {
        "type": "object",
        "description": "The Python `ThreadResponse` projection every lifecycle writer returns.",
        "required": [
