      "StaleThreadListResponse": {
        "type": "object",
        "description": "Stale threads page returned by `filter=stale` on the v2 collection.\n\nStale rows are still active queue rows, but the legacy stale read projects\nthe full detail-shaped `ThreadResponse` instead of the queue-list item. The\ndistinction is kept on the wire so callers of the retired v1 stale read can\nmigrate without losing fields; counts stay zero/absent because the stale\nread never published a whole-queue total.",
        "required": [
          "threads",
          "active_count"
        ],
        "properties": {
          "active_count": {
            "type": "integer",
            "format": "int32",
            "description": "Always zero: a stale page is not a whole-active-queue read."
          },
          "filtered_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Always absent: the stale read never measured a filtered whole-queue total."
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThreadResponse"
            }
          }
        }
      },
      "ThreadCreateRequest": {
        "type": "object",
        "description": "Body of `POST /api/v1/threads/`.",
        "required": [
          "title",
          "format",
          "issues_remaining"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "is_test": {
            "type": "boolean"
          },
          "issues_remaining": {
            "type": "integer",
            "format": "int32"
          },
          "manual_creator_credits": {
            "type": "array",
            "items": {}
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "total_issues": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ThreadDetailResponse": {
        "type": "object",
        "description": "The legacy single-thread response retained for the v1 and bare aliases.",
        "required": [
          "id",
          "title",
          "format",
          "issues_remaining",
          "queue_position",
          "status",
          "is_test",
