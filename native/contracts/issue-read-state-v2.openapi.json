{
  "openapi": "3.1.0",
  "info": {
    "title": "ComicPile native issue read-state v2 API",
    "description": "Generated contract for the native issue read-state, position and reader-context resources.",
    "license": {
      "name": ""
    },
    "version": "2.0.0"
  },
  "paths": {
    "/api/v2/issue-read-marker-removals": {
      "post": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for removing read markers in bulk.",
        "operationId": "issue_read_state_bulk_mark_unread",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueBulkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Every issue marked unread atomically"
          },
          "400": {
            "description": "An issue is already marked as unread"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Issue not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/issue-read-markers": {
      "post": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for creating read markers in bulk.",
        "operationId": "issue_read_state_bulk_mark_read",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueBulkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Every issue marked read atomically"
          },
          "400": {
            "description": "An issue is already marked as read"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Issue not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/issues/{issue_id}/position": {
      "put": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for setting an issue position.",
        "operationId": "issue_read_state_move",
        "parameters": [
          {
            "name": "issue_id",
            "in": "path",
            "description": "Owned Issue identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueMoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Issue moved within its thread"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Issue or anchor issue not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/issues/{issue_id}/read-markers": {
      "post": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for creating an issue read marker.",
        "operationId": "issue_read_state_mark_read",
        "parameters": [
          {
            "name": "issue_id",
            "in": "path",
            "description": "Owned Issue identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Issue marked read and the thread counters refreshed"
          },
          "400": {
            "description": "Issue is already marked as read"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Issue not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for deleting an issue read marker.",
        "operationId": "issue_read_state_mark_unread",
        "parameters": [
          {
            "name": "issue_id",
            "in": "path",
            "description": "Owned Issue identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Issue marked unread; a completed thread is reactivated"
          },
          "400": {
            "description": "Issue is already marked as unread"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Issue not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/issues/{issue_id}/reader-context": {
      "get": {
        "tags": [
          "issues"
        ],
        "summary": "Documentation-only operation for reader context.",
        "operationId": "issue_read_state_reader_context",
        "parameters": [
          {
            "name": "issue_id",
            "in": "path",
            "description": "Owned Issue identifier",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded reader context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderContextResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Issue not found"
          },
          "422": {
            "description": "Request validation failed"
          },
          "503": {
            "description": "Database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "IssueBulkRequest": {
        "type": "object",
        "description": "Request body for the bulk read-state operations.",
        "required": [
          "issue_ids"
        ],
        "properties": {
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "maxItems": 100,
            "minItems": 1
          }
        }
      },
      "IssueMoveRequest": {
        "type": "object",
        "description": "Request body for `PUT /api/v2/issues/{issue_id}/position`.",
        "required": [
          "after_issue_id"
        ],
        "properties": {
          "after_issue_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Move after this issue. `null` moves the issue to position 1.",
            "minimum": 1
          }
        }
      },
      "ReaderContextCrossover": {
        "type": "object",
        "description": "Python `ReaderContextCrossover`.",
        "required": [
          "id",
          "name",
          "applies_to_current_issue",
          "membership_kind",
          "ratings_count",
          "read_count"
        ],
        "properties": {
          "applies_to_current_issue": {
            "type": "boolean"
          },
          "average_rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "membership_kind": {
            "type": "string",
            "description": "`issue` or `thread`."
          },
          "name": {
            "type": "string"
          },
          "next_member": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReaderContextCrossoverNextMember"
              },
              {
                "type": "null"
              }
            ]
          },
          "ratings_count": {
            "type": "integer",
            "format": "int64"
          },
          "read_count": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ReaderContextCrossoverMembership": {
        "type": "object",
        "description": "Python `ReaderContextCrossoverMembership`.",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ReaderContextCrossoverNextMember": {
        "type": "object",
        "description": "Python `ReaderContextCrossoverNextMember`.",
        "required": [
          "issue_id",
          "issue_number"
        ],
        "properties": {
          "issue_id": {
            "type": "integer",
            "format": "int32"
          },
          "issue_number": {
            "type": "string"
          }
        }
      },
      "ReaderContextEdge": {
        "type": "object",
        "description": "Python `ReaderContextEdge`.",
        "required": [
          "id",
          "kind",
          "source_issue_id",
          "target_issue_id"
        ],
        "properties": {
          "explanation": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "type": "string",
            "description": "`dependency` or `continuity`."
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_issue_id": {
            "type": "integer",
            "format": "int32"
          },
          "source_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_thread_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "source_thread_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_issue_id": {
            "type": "integer",
            "format": "int32"
          },
          "target_issue_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_thread_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "target_thread_title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ReaderContextLocalChain": {
        "type": "object",
        "description": "Python `ReaderContextLocalChain`.",
        "required": [
          "issues",
          "edges"
        ],
        "properties": {
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReaderContextEdge"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReaderContextLocalIssue"
            }
          }
        }
      },
      "ReaderContextLocalIssue": {
        "type": "object",
        "description": "Python `ReaderContextLocalIssue`.",
        "required": [
          "issue_id",
          "issue_number",
          "position",
          "status",
          "relation",
          "crossover_memberships"
        ],
        "properties": {
          "crossover_memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReaderContextCrossoverMembership"
            }
          },
          "issue_id": {
            "type": "integer",
            "format": "int32"
          },
          "issue_number": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "relation": {
            "type": "string",
            "description": "`previous`, `current`, `next` or `future`."
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ReaderContextPreviousIssue": {
        "type": "object",
        "description": "Python `ReaderContextPreviousIssue`.",
        "required": [
          "issue_id",
          "issue_number"
        ],
        "properties": {
          "issue_id": {
            "type": "integer",
            "format": "int32"
          },
          "issue_number": {
            "type": "string"
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "ReaderContextRecentRating": {
        "type": "object",
        "description": "Python `ReaderContextRecentRating`.",
        "required": [
          "issue_id",
          "issue_number",
          "rating"
        ],
        "properties": {
          "issue_id": {
            "type": "integer",
            "format": "int32"
          },
          "issue_number": {
            "type": "string"
          },
          "rating": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ReaderContextResponse": {
        "type": "object",
        "description": "Python `ReaderContextResponse`.",
        "required": [
          "issue_id",
          "series",
          "crossovers",
          "local_chain"
        ],
        "properties": {
          "crossovers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReaderContextCrossover"
            }
          },
          "issue_id": {
            "type": "integer",
            "format": "int32"
          },
          "local_chain": {
            "$ref": "#/components/schemas/ReaderContextLocalChain"
          },
          "series": {
            "$ref": "#/components/schemas/ReaderContextSeries"
          }
        }
      },
      "ReaderContextSeries": {
        "type": "object",
        "description": "Python `ReaderContextSeries`.",
        "required": [
          "identity_source",
          "ratings_count",
          "recent_ratings"
        ],
        "properties": {
          "average_rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "canonical_series_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "highest_rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "identity_source": {
            "type": "string",
            "description": "`comicvine` or `unavailable`."
          },
          "lowest_rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "previous_issue": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReaderContextPreviousIssue"
              },
              {
                "type": "null"
              }
            ]
          },
          "ratings_count": {
            "type": "integer",
            "format": "int64"
          },
          "recent_ratings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReaderContextRecentRating"
            }
          },
          "series_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
