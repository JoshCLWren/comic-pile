# Test environment for Docker-based E2E tests
# Source with: source .env.test

# Application environment (enables test-only endpoints like /api/test/sessions/expire)
ENVIRONMENT=test

# Database configuration for the native Rust service (Docker PostgreSQL on port 5437).
# One plain PostgreSQL URL: there is no second, Python-era DB pin.
RUST_ROLL_DATABASE_URL=postgresql://postgres:postgres@localhost:5437/comic_pile_test

# Disable auto-backup in tests
AUTO_BACKUP_ENABLED=false

# Skip worktree validation in tests
SKIP_WORKTREE_CHECK=true

# Fixed secret key ensures consistent JWT signing across uvicorn workers
SECRET_KEY=test-secret-key-for-testing-only

# No cache/Redis/Upstash environment variables here: the backend application
# cache was deleted in issue #2974, so tests exercise the uncached path.

# Rate limiting - disabled by default for Playwright tests
# The pytest rate limit tests (test_rate_limit*.py) explicitly monkeypatch
# ENABLE_RATE_LIMITING_IN_TESTS=true when they need rate limiting active.
TEST_ENVIRONMENT=true
ENABLE_RATE_LIMITING_IN_TESTS=false
