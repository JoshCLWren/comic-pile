# Local Python environments and caches
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Rust build artifacts belong in the build cache, never the uploaded source.
target/
native/**/target/
.coverage
htmlcov/

# Frontend dependencies and build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Local environment and editor files
.env
.env.*
!.env.example
.vscode/
.idea/

# Test, benchmark, and generated artifacts
test-results/
playwright-report/
benchmarks/results/
coverage/
*.log

# Tests and test fixtures (not imported by production request path)
tests/
tests_e2e/

# Repository docs and non-runtime material
docs/

# Root-only CI / automation / factory scripts (not imported by api/index.py).
# Anchored so frontend/scripts/ (sitemap generator) is still uploaded.
/scripts/
.github/

# Migration files not needed at serverless request time
alembic/

# Factory / agent / prompt artifacts not imported by api/index.py
.agents/
.opencode/
prompts/

# Database backups and exports
*.dump
*.sql
# The one .sql exception: the native Rust build compiles the canonical Alembic
# schema in at build time (`include_str!` in native/roll-service/src/test_support.rs),
# so Vercel must upload it. `tests/test_vercel_upload_guard.py` pins this.
!native/roll-service/src/schema/public_schema.sql
*_backup_*.json
prod_backup*
