{
  "family": "activity",
  "owned_path_patterns": ["^/api/v2/activity$"],
  "defaults": {"owning_issue": 4822},
  "operations": [
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/activity",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/activity$",
      "runtime": "native-rust",
      "status": "target",
      "consumers": ["frontend/src/services/api-activity.ts"],
      "sql_budget": {
        "application_statements": 1,
        "transaction_control_statements": 0,
        "total_statements": 1,
        "basis": "One owner-scoped cursor page: a single statement folds authentication, ownership, the snooze/roll and dice/issue rate linkage, and the page limit with no per-row follow-up queries."
      }
    }
  ]
}
