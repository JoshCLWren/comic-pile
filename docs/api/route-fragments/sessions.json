{
  "family": "sessions",
  "owned_path_patterns": [
    "^/api/v2/reading-sessions/[^/]+/(?:details|snapshots)$"
  ],
  "defaults": {
    "owning_issue": 4839,
    "runtime": "native-rust",
    "status": "target",
    "consumers": [
      "frontend/src/services/api-sessions.ts"
    ]
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/reading-sessions/{session_id}/details",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/reading-sessions/[^/]+/details$",
      "consumers": [
        "frontend/src/services/api-sessions.ts"
      ]
    },
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/reading-sessions/{session_id}/snapshots",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/reading-sessions/[^/]+/snapshots$",
      "consumers": [
        "frontend/src/services/api-sessions.ts"
      ]
    }
  ]
}
