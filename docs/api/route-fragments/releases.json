{
  "family": "releases",
  "owned_path_patterns": [
    "^/api/v2/releases$"
  ],
  "defaults": {
    "owning_issue": 4849,
    "runtime": "native-rust",
    "status": "target",
    "consumers": []
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/releases",
      "dest": "/api/native_api.rs",
      "src": "^/api/v2/releases$",
      "sql_budget": {
        "application_statements": 2,
        "transaction_control_statements": 0,
        "total_statements": 2,
        "basis": "one COUNT(*) over the published/public/readable filter plus one page SELECT with LIMIT/OFFSET; set-based, independent of library size, no per-row N+1"
      },
      "consumers": [
        "frontend/src/services/api-releases.ts"
      ]
    }
  ]
}
