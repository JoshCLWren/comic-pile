{
  "family": "undo",
  "owned_path_patterns": [
    "^/api/v1/undo(?:/.*)?$",
    "^/api/undo(?:/.*)?$"
  ],
  "defaults": {
    "runtime": "python-fastapi",
    "status": "transitional",
    "owning_issue": null,
    "consumers": [
      "frontend/src/services/api-undo.ts"
    ]
  },
  "operations": [
    {
      "bucket": "unversioned_operations",
      "method": "GET",
      "path": "/api/undo/{session_id}/snapshots",
      "dest": "/api/native_roll.rs",
      "src": "^/api/undo/[^/]+/snapshots$",
      "owning_issue": 4839,
      "exclude_from_inventory": true
    },
    {
      "bucket": "unversioned_operations",
      "method": "POST",
      "path": "/api/undo/{session_id}/undo/{snapshot_id}",
      "dest": "/api/native_roll.rs",
      "src": "^/api/undo/[^/]+/undo/[^/]+$",
      "owning_issue": 4839,
      "exclude_from_inventory": true
    },
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/undo/{session_id}/snapshots",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/undo/[^/]+/snapshots$",
      "owning_issue": 4839,
      "exclude_from_inventory": true
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/undo/{session_id}/undo/{snapshot_id}",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/undo/[^/]+/undo/[^/]+$",
      "owning_issue": 4839,
      "exclude_from_inventory": true
    }
  ]
}
