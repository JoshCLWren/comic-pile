{
  "family": "undo",
  "owned_path_patterns": [
    "^/api/v2/undo(?:/.*)?$"
  ],
  "defaults": {
    "runtime": "native-rust",
    "status": "target",
    "owning_issue": null,
    "consumers": [
      "frontend/src/services/api-undo.ts"
    ]
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/undo/{session_id}/snapshots",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/undo/[^/]+/snapshots$",
      "owning_issue": 4839,
      "runtime": "native-rust",
      "status": "target"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/undo/{session_id}/snapshots/{snapshot_id}/restore",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/undo/[^/]+/snapshots/[^/]+/restore$",
      "owning_issue": 4839,
      "runtime": "native-rust",
      "status": "target"
    }
  ]
}
