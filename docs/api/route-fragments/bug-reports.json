{
  "family": "bug-reports",
  "owned_path_patterns": [
    "^/api/v1/bug\\-reports(?:/.*)?$",
    "^/api/bug\\-reports(?:/.*)?$",
    "^/api/v2/bugReports(?:/.*)?$"
  ],
  "defaults": {
    "runtime": "python-fastapi",
    "status": "transitional",
    "owning_issue": null,
    "consumers": [
      "frontend/src/services/api-bug-reports.ts"
    ]
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/bugReports",
      "dest": "/api/native_api.rs",
      "src": "^/api/v2/bugReports$",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 5718,
      "consumers": [
        "frontend/src/services/api-bug-reports.ts"
      ]
    },
    {
      "bucket": "unversioned_operations",
      "method": "POST",
      "path": "/api/bug-reports/",
      "dest": "/api/native_api.rs",
      "src": "^/api/bug\\-reports/$",
      "owning_issue": 4852,
      "exclude_from_inventory": true
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/bug-reports/",
      "dest": "/api/native_api.rs",
      "src": "^/api/v1/bug\\-reports/$",
      "owning_issue": 4852,
      "exclude_from_inventory": true
    }
  ]
}
