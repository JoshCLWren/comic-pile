      "dest": "/api/index.py",
      "src": "^/api/v1/custom\\-cbls/[^/]+/reader$"
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/custom-cbls/{list_id}/reading-plans/{plan_id}:apply",
      "dest": "/api/index.py",
      "src": "^/api/v1/custom\\-cbls/[^/]+/reading\\-plans/[^/]+:apply$"
    }
  ]
}
