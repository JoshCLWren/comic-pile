{
  "family": "preferences",
  "owned_path_patterns": [
    "^/api/v1/users/me/taste\\-signals(?:/.*)?$",
    "^/api/v2/users/me/preferences$"
  ],
  "defaults": {
    "runtime": "python-fastapi",
    "status": "transitional",
    "owning_issue": null,
    "consumers": [
      "frontend/src/services/api-preferences.ts",
      "frontend/src/services/api-taste.ts"
    ]
  },
  "operations": [
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/users/me/taste-signals",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/users/me/taste\\-signals$",
      "owning_issue": 4834,
      "exclude_from_inventory": true
    },
    {
      "bucket": "v1_operations",
      "method": "PUT",
      "path": "/api/v1/users/me/taste-signals/{signal_type}/{external_key}/verdict",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/users/me/taste\\-signals/[^/]+/[^/]+/verdict$",
      "owning_issue": 4834,
      "exclude_from_inventory": true
    },
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/users/me/preferences",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/users/me/preferences$",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 4335,
      "consumers": [
        "frontend/src/services/api-preferences.ts"
      ]
    },
    {
      "bucket": "operations",
      "method": "PATCH",
      "path": "/api/v2/users/me/preferences",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/users/me/preferences$",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 4335,
      "consumers": [
        "frontend/src/services/api-preferences.ts"
      ]
    }
  ]
}
