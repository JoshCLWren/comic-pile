{
  "family": "roll",
  "owned_path_patterns": [
    "^/api/v1/roll/events/[^/]+/recommendation-explanation$",
    "^/api/roll/events/[^/]+/recommendation-explanation$",
    "^/api/v2/roll/unsnooze$",
    "^/api/v2/roll/override$",
    "^/api/v2/roll/dismiss-pending$",
    "^/api/v2/roll/switch-prerequisite$",
    "^/api/v2/roll/last-read$",
    "^/api/v2/roll/recovery$"
  ],
  "defaults": {
    "runtime": "native-rust",
    "status": "target",
    "owning_issue": 4850,
    "consumers": [
      "frontend/src/services/api-roll.ts",
      "frontend/src/services/rollStateApi.ts"
    ]
  },
  "operations": [
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/roll/events/{event_id}/recommendation-explanation",
      "dest": "/api/native_api.rs",
      "src": "^/api/v1/roll/events/[^/]+/recommendation\\-explanation$",
      "exclude_from_inventory": true
    },
    {
      "bucket": "unversioned_operations",
      "method": "GET",
      "path": "/api/roll/events/{event_id}/recommendation-explanation",
      "dest": "/api/native_api.rs",
      "src": "^/api/roll/events/[^/]+/recommendation\\-explanation$",
      "consumers": [],
      "exclude_from_inventory": true
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/roll/unsnooze",
      "dest": "/api/native_api.rs",
      "src": "^/api/v2/roll/unsnooze$",
      "consumers": [
        "frontend/src/services/api-roll.ts"
      ]
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/roll/dismiss-pending",
      "dest": "/api/native_api.rs",
      "src": "^/api/v2/roll/dismiss\\-pending$",
      "consumers": [
        "frontend/src/services/api-roll.ts"
      ]
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/roll/switch-prerequisite",
      "dest": "/api/native_api.rs",
      "src": "^/api/v2/roll/switch\\-prerequisite$",
      "consumers": [
        "frontend/src/services/rollStateApi.ts"
      ]
    },
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/roll/last-read",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/roll/last-read$",
      "owning_issue": 4350,
      "consumers": [
        "frontend/src/services/rollResourcesApi.ts"
      ]
    },
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/roll/recovery",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/roll/recovery$",
      "owning_issue": 4350,
      "consumers": [
        "frontend/src/services/rollResourcesApi.ts"
      ]
    }
  ]
}
