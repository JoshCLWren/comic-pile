{
  "family": "reading-mode",
  "owned_path_patterns": [
    "^/api/v1/reading\\-mode(?:/.*)?$"
  ],
  "defaults": {
    "runtime": "python-fastapi",
    "status": "transitional",
    "owning_issue": null,
    "consumers": [
      "frontend/src/services/readingMode.ts"
    ]
  },
  "operations": [
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/reading-mode",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/reading\\-mode$"
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/reading-mode",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/reading\\-mode$"
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/reading-mode/dismiss-suggestion",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/reading\\-mode/dismiss\\-suggestion$"
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/reading-mode/suggest",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/reading\\-mode/suggest$"
    }
  ]
}
