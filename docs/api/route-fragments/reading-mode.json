{
  "family": "reading-mode",
  "owned_path_patterns": [
    "^/api/v2/reading\\-mode(?:/.*)?$"
  ],
  "defaults": {
    "runtime": "python-fastapi",
    "status": "transitional",
    "owning_issue": null,
    "consumers": [
      "frontend/src/services/readingMode.ts"
    ]
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/reading-mode",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/reading\\-mode$",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 4335
    },
    {
      "bucket": "operations",
      "method": "PUT",
      "path": "/api/v2/reading-mode",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/reading\\-mode$",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 4335
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/reading-mode/suggestion-dismissals",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/reading\\-mode/suggestion\\-dismissals$",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 4335
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/reading-mode/suggestions",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/reading\\-mode/suggestions$",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 4335
    }
  ]
}
