{
  "family": "auth",
  "owned_path_patterns": [
    "^/api/v2/auth/csrf$",
    "^/api/v2/auth/forgot-password$",
    "^/api/v2/auth/login$",
    "^/api/v2/auth/logout$",
    "^/api/v2/auth/me$",
    "^/api/v2/auth/refresh$",
    "^/api/v2/auth/register$",
    "^/api/v2/auth/reset-password$"
  ],
  "defaults": {
    "owning_issue": 4459,
    "runtime": "native-rust",
    "status": "target",
    "consumers": [
      "frontend/src/services/api.ts",
      "frontend/src/services/api-auth.ts"
    ]
  },
  "vercel_generation": {
    "retired_rewrite_srcs": [
      "/api/v1/auth/register",
      "/api/v1/auth/login",
      "/api/v1/auth/refresh",
      "/api/v1/auth/logout",
      "/api/v1/auth/csrf",
      "/api/v1/auth/me",
      "/api/v1/auth/forgot-password",
      "/api/v1/auth/reset-password",
      "/api/auth/register",
      "/api/auth/login",
      "/api/auth/refresh",
      "/api/auth/logout",
      "/api/auth/csrf",
      "/api/auth/me",
      "/api/auth/forgot-password",
      "/api/auth/reset-password"
    ]
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/auth/csrf",
      "dest": "/api/native_api.rs"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/auth/forgot-password",
      "dest": "/api/native_api.rs"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/auth/login",
      "dest": "/api/native_api.rs"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/auth/logout",
      "dest": "/api/native_api.rs"
    },
    {
      "bucket": "operations",
      "method": "GET",
      "path": "/api/v2/auth/me",
      "dest": "/api/native_api.rs"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/auth/refresh",
      "dest": "/api/native_api.rs"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/auth/register",
      "dest": "/api/native_api.rs"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/auth/reset-password",
      "dest": "/api/native_api.rs"
    }
  ]
}
