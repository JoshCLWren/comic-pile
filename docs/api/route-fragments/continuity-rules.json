{
  "family": "continuity-rules",
  "owned_path_patterns": [
    "^/api/v1/continuity\\-rules(?:/.*)?$"
  ],
  "defaults": {
    "runtime": "python-fastapi",
    "status": "transitional",
    "owning_issue": null,
    "consumers": [
      "frontend/src/services/api-continuity-rules.ts"
    ]
  },
  "operations": [
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/continuity-rules/",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/continuity\\-rules/$"
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/continuity-rules/",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/continuity\\-rules/$"
    },
    {
      "bucket": "v1_operations",
      "method": "DELETE",
      "path": "/api/v1/continuity-rules/{rule_id}",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/continuity\\-rules/[^/]+$"
    },
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/continuity-rules/{rule_id}",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/continuity\\-rules/[^/]+$"
    },
    {
      "bucket": "v1_operations",
      "method": "PUT",
      "path": "/api/v1/continuity-rules/{rule_id}",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v1/continuity\\-rules/[^/]+$"
    }
  ]
}
