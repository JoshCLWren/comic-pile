{
  "family": "dependencies",
  "owned_path_patterns": [
    "^/api/v2/dependencies(?:/.*)?$",
    "^/api/v1/.*dependencies(?:/.*)?$"
  ],
  "defaults": {
    "runtime": "python-fastapi",
    "status": "transitional",
    "owning_issue": null
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/dependencies/",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 4684,
      "consumers": ["frontend/src/services/api-dependencies.ts"]
    },
    {
      "bucket": "operations",
      "method": "DELETE",
      "path": "/api/v2/dependencies/{dependency_id}",
      "runtime": "native-rust",
      "status": "target",
      "owning_issue": 4684,
      "consumers": ["frontend/src/services/api-dependencies.ts"]
    },
    {
      "bucket": "v1_operations",
      "method": "DELETE",
      "path": "/api/v1/continuity-plans/{plan_id}/dependencies/{dependency_id}",
      "consumers": [
        "frontend/src/services/api-continuity-plans.ts",
        "frontend/src/services/api-reading-orders.ts"
      ]
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/continuity-plans/{plan_id}/dependencies/{dependency_id}",
      "consumers": [
        "frontend/src/services/api-continuity-plans.ts",
        "frontend/src/services/api-reading-orders.ts"
      ]
    },
    {
      "bucket": "v1_operations",
      "method": "POST",
      "path": "/api/v1/dependencies/",
      "consumers": ["frontend/src/services/api-dependencies.ts"]
    },
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/dependencies/blocked",
      "consumers": ["frontend/src/services/api-dependencies.ts"]
    },
    {
      "bucket": "v1_operations",
      "method": "DELETE",
      "path": "/api/v1/dependencies/{dependency_id}",
      "consumers": ["frontend/src/services/api-dependencies.ts"]
    },
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/dependencies/{dependency_id}",
      "consumers": ["frontend/src/services/api-dependencies.ts"]
    },
    {
      "bucket": "v1_operations",
      "method": "PATCH",
      "path": "/api/v1/dependencies/{dependency_id}",
      "consumers": ["frontend/src/services/api-dependencies.ts"]
    },
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/issues/{issue_id}/dependencies",
      "consumers": [
        "frontend/src/services/api-dependencies.ts",
        "frontend/src/services/api-issues.ts",
        "frontend/src/services/api-reader-context.ts"
      ]
    },
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/threads/{thread_id}/dependencies",
      "consumers": [
        "frontend/src/services/api-dependencies.ts",
        "frontend/src/services/api-dependency-groups.ts",
        "frontend/src/services/api-issues.ts",
        "frontend/src/services/api-migration.ts",
        "frontend/src/services/api-reading-orders.ts",
        "frontend/src/services/api-threads.ts"
      ]
    },
    {
      "bucket": "v1_operations",
      "method": "GET",
      "path": "/api/v1/threads/{thread_id}/issue-dependencies",
      "consumers": [
        "frontend/src/services/api-dependencies.ts",
        "frontend/src/services/api-dependency-groups.ts",
        "frontend/src/services/api-issues.ts",
        "frontend/src/services/api-migration.ts",
        "frontend/src/services/api-reading-orders.ts",
        "frontend/src/services/api-threads.ts"
      ]
    }
  ]
}
