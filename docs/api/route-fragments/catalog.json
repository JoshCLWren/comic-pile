    "^/api/v1/catalog/series-mappings/preview$",
    "^/api/v2/series-mapping-commits$"
  ],
  "defaults": {
    "runtime": "python-fastapi",
    "status": "transitional",
    "owning_issue": null,
    "consumers": [
      "frontend/src/services/api-series-mapping.ts"
    ]
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "POST",
