{
  "family": "ping",
  "owned_path_patterns": [
    "^/api/ping$"
  ],
  "defaults": {
    "owning_issue": 5285,
    "runtime": "native-rust",
    "status": "target",
    "consumers": []
  },
  "operations": [
    {
      "bucket": "unversioned_operations",
      "method": "GET",
      "path": "/api/ping",
      "dest": "/api/native_roll.rs",
      "src": "^/api/ping$",
      "db_free": true,
      "sql_budget": {
        "application_statements": 0,
        "transaction_control_statements": 0,
        "total_statements": 0,
        "basis": "Cold-start probe; native ingress serves fixed alive response without PostgreSQL",
        "max_statements": 0,
        "grows_with_data": false
      }
    }
  ]
}
