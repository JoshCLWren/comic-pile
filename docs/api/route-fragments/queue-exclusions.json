{
  "family": "queue-exclusions",
  "owned_path_patterns": [
    "^/api/v2/queue-exclusions(?:/.*)?$",
    "^/api/v2/queue-exclusion-groups(?:/.*)?$"
  ],
  "defaults": {
    "runtime": "native-rust",
    "status": "target",
    "owning_issue": 5435,
    "consumers": [
      "frontend/src/services/api-threads.ts"
    ]
  },
  "operations": [
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/queue-exclusions",
      "dest": "/api/native_roll.rs",
      "src": "/api/v2/queue-exclusions"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/queue-exclusions/status:check",
      "dest": "/api/native_roll.rs",
      "src": "/api/v2/queue-exclusions/status:check"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/queue-exclusions/restore",
      "dest": "/api/native_roll.rs",
      "src": "/api/v2/queue-exclusions/restore"
    },
    {
      "bucket": "operations",
      "method": "POST",
      "path": "/api/v2/queue-exclusion-groups/{group_id}/restore",
      "dest": "/api/native_roll.rs",
      "src": "^/api/v2/queue-exclusion-groups/[0-9]+/restore$"
    }
  ]
}
