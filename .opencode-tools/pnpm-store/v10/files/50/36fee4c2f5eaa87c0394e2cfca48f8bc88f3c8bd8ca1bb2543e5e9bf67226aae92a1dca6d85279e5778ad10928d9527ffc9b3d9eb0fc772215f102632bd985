{
  "name": "@vitest/ui",
  "type": "module",
  "version": "5.1.0",
  "description": "UI for Vitest",
  "license": "MIT",
  "funding": "https://opencollective.com/vitest",
  "homepage": "https://vitest.dev/guide/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitest-dev/vitest.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/vitest-dev/vitest/issues"
  },
  "keywords": [
    "vitest",
    "html",
    "reporter"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "__vitest_source__": "./node/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "__vitest_source__": "./node/reporter.ts",
      "types": "./reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "*.d.ts",
    "dist"
  ],
  "peerDependencies": {
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@vitest/utils": "5.1.0",
    "fflate": "^0.8.3",
    "flatted": "^3.4.4",
    "pathe": "^2.0.3",
    "sirv": "^3.0.2",
    "tinyrainbow": "^3.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@flakiness/vitest": "^1.12.0",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/logos": "^1.2.17",
    "@types/codemirror": "^5.60.18",
    "@types/d3-selection": "^3.0.12",
    "@unocss/reset": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/browser-preview": "5.1.0",
    "@vueuse/core": "^14.4.0",
    "ansi-to-html": "^0.7.2",
    "birpc": "^4.2.0",
    "codemirror": "^5.65.18",
    "codemirror-theme-vars": "^0.1.2",
    "cookie": "^2.0.1",
    "d3-graph-controller": "^3.1.13",
    "floating-vue": "^5.4.0",
    "mime": "^4.1.1",
    "rollup": "^4.64.10",
    "rrweb-snapshot": "2.1.1",
    "splitpanes": "^4.1.2",
    "typescript": "^5.9.3",
    "unocss": "^66.11.0",
    "vite": "latest",
    "vitest-browser-vue": "3.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "vue-virtual-scroller": "2.0.1"
  },
  "scripts": {
    "build": "premove dist && pnpm build:node && pnpm build:client",
    "build:client": "vite build",
    "build:node": "rollup -c",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "vue-tsc --noEmit",
    "dev:client": "vite",
    "dev": "rollup -c --watch --watch.include 'node/**'",
    "dev:ui": "pnpm run --stream '/^(dev|dev:client)$/'",
    "test:ui": "vitest"
  }
}